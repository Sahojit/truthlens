# ============================================================
# FAKE NEWS DETECTOR — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/fakenews?retryWrites=true&w=majority
DATABASE_NAME=fakenews

# --- JWT Auth ---
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- HuggingFace (optional, for downloading models) ---
HUGGINGFACE_TOKEN=

# --- Model Paths ---
MODELS_DIR=./trained_models
BERT_MODEL_PATH=./trained_models/bert_classifier
BILSTM_MODEL_PATH=./trained_models/bilstm_model.h5
XGBOOST_MODEL_PATH=./trained_models/xgboost_model.pkl
LOGISTIC_MODEL_PATH=./trained_models/logistic_model.pkl
TFIDF_VECTORIZER_PATH=./trained_models/tfidf_vectorizer.pkl
LABEL_ENCODER_PATH=./trained_models/label_encoder.pkl

# --- Sentence Transformer ---
SBERT_MODEL=all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=TruthLens
